[Unit]
Description=Local NTP time sync (busybox ntpd, client-only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/default/busybox-ntpd
ExecStart=/usr/bin/busybox.static ntpd -n -p ${NTP_SERVER}
Restart=on-failure
RestartSec=15
StandardOutput=append:/var/log/ntpd.log
StandardError=append:/var/log/ntpd.log
SyslogIdentifier=busybox-ntpd

[Install]
WantedBy=multi-user.target
